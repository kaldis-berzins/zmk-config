#include <behaviors.dtsi>
#include <dt-bindings/zmk/behaviors.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        behaviors {
                hml: home_row_mod_left {
                    compatible = "zmk,behavior-hold-tap";
                    #binding-cells = <2>;
                    flavor = "balanced";
                    require-prior-idle-ms = <150>;
                    tapping-term-ms = <280>;
                    quick-tap-ms = <175>;
                    bindings = <&kp>, <&kp>;
                    hold-trigger-key-positions = <6 7 8 9 10 18 19 20 21 22 30 31 32 33 34>; // List of keys on the right side of the keyboard
                    hold-trigger-on-release;
                };
                hmr: home_row_mod_right {
                    compatible = "zmk,behavior-hold-tap";
                    #binding-cells = <2>;
                    flavor = "balanced";
                    require-prior-idle-ms = <150>;
                    tapping-term-ms = <280>;
                    quick-tap-ms = <175>;
                    bindings = <&kp>, <&kp>;
                    hold-trigger-key-positions = <1 2 3 4 5 13 14 15 16 17 25 26 27 28 29>; // List of keys on the left side of the keyboard
                    hold-trigger-on-release;
                };
                lt: layer_tap {
                    compatible = "zmk,behavior-hold-tap";
                    #binding-cells = <2>;
                    flavor = "tap-preferred";
                    tapping-term-ms = <200>;
                    bindings = <&mo>, <&kp>;
                    display-name = "Layer-Tap";
                };
        };

        combos {
                compatible = "zmk,combos";
                combo_tab {
                        timeout-ms = <50>;
                        key-positions = <1 2>;
                        bindings = <&kp TAB>;
                };
                combo_tilde {
                        timeout-ms = <50>;
                        key-positions = <33 34>;
                        bindings = <&kp TILDE>;
                };
                combo_apostrophe {
                        timeout-ms = <50>;
                        key-positions = <21 22>;
                        bindings = <&kp SQT>;
                };
        };

        keymap {
                compatible = "zmk,keymap";
// -------------------------------- DEFAULT LAYER --------------------------------------------
                default_layer {
// |-----|  Q-TAB-W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |-----|
// |-----| G(A)| A(S)| S(D)| C(F)|  G  |   |  H  | C(J)| S(K)| A(L)| G(;)|-----|
// |-----|  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  ~  /  |-----|
//                   |GRESC|L SPC| RSE |   |SHIFT|L RET| BSPC|
                        bindings = <
   &none &kp Q       &kp W       &kp E         &kp R        &kp T     &kp Y      &kp U        &kp I         &kp O       &kp P          &none // Last key in row: 11
   &none &hml LGUI A &hml LALT S &hml LSHIFT D &hml LCTRL F &kp G     &kp H      &hmr RCTRL J &hmr RSHIFT K &hmr RALT L &hmr RGUI SEMI &none // Last key in row: 23
   &none &kp Z       &kp X       &kp C         &kp V        &kp B     &kp N      &kp M        &kp COMMA     &kp DOT     &kp FSLH       &none
                                 &gresc        &lt 1 SPACE  &mo 2     &kp LSHIFT &lt 1 RET    &kp BSPC
                        >;
                };
// ---------------------------------- LOWER LAYER --------------------------------------------
                lower_layer {
// |      |     |     |     |SPST | PST |   | PST |     |  UP |     |     |      |
// |      |     |     |     |SCPY | CPY |   | CPY | LFT | DWN | RGT |SCSHT|      |
// |      |     |     |     |SCUT | CUT |   | CUT |     |     |     |     |      |
//                    |     |     |     |   |     |     |     |
                        bindings = <
   &trans &trans &trans &trans &kp LS(LC(V) &kp LC(V)   &kp LC(V) &trans   &kp UP   &trans    &trans &trans
   &trans &trans &trans &trans &kp LS(LC(C) &kp LC(C)   &kp LC(C) &kp LEFT &kp DOWN &kp RIGHT &trans &trans
   &trans &trans &trans &trans &kp LS(LC(X) &kp LC(X)   &kp LC(X) &trans   &trans   &trans    &trans &trans
                        &trans &trans       &trans      &trans    &trans   &trans
                        >;
                };
// ---------------------------------- RAISE LAYER --------------------------------------------
                raise_layer {
// |-----|  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |-----|
// |-----| G(1)| A(2)| S(3)| C(4)|  5  |   | C(6)| S(7)| A(8)| G(9)|  0  |-----|
// |-----|  \  |  [  |  ]  |  =  |  _  |   |  -  |  +  |  {  |  }  | "|" |-----|
//                   |     |     |     |   |  '  |  "  | DEL |
                        bindings = <
   &none &kp EXCL      &kp AT       &kp HASH       &kp DLLR      &kp PRCNT     &kp CARET &kp AMPS      &kp ASTRK      &kp LPAR     &kp RPAR     &none
   &none &hml LGUI N1  &hml LALT N2 &hml LSHIFT N3 &hml LCTRL N4 &kp N5        &kp N6    &hmr RCTRL N7 &hmr RSHIFT N8 &hmr RALT N9 &hmr RGUI N0 &none
   &none &kp BACKSLASH &kp LBKT     &kp RBKT       &kp EQUAL     &kp UNDER     &kp MINUS &kp PLUS      &kp LBRC       &kp RBRC     &kp PIPE     &none
                                    &trans         &trans        &trans        &kp SQT   &kp DQT       &kp DEL
                        >;
                };
        };
};


